RewriteEngine On

# 1. HTTP -> HTTPS (preserves host)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. www + index.html -> canonical in one hop
RewriteCond %{HTTP_HOST} ^www\.myfixhive\.ae$ [NC]
RewriteCond %{REQUEST_URI} ^/index\.html$
RewriteRule ^ https://myfixhive.ae/ [R=301,L]

# 3. www + /ar/index.html -> canonical in one hop
RewriteCond %{HTTP_HOST} ^www\.myfixhive\.ae$ [NC]
RewriteCond %{REQUEST_URI} ^/ar/index\.html$
RewriteRule ^ https://myfixhive.ae/ar/ [R=301,L]

# 4. www -> non-www (all other pages)
RewriteCond %{HTTP_HOST} ^www\.myfixhive\.ae$ [NC]
RewriteRule ^(.*)$ https://myfixhive.ae/$1 [R=301,L]

# 5. /index.html -> / (non-www)
RewriteRule ^index\.html$ https://myfixhive.ae/ [R=301,L]

# 6. /ar/index.html -> /ar/ (non-www)
RewriteRule ^ar/index\.html$ https://myfixhive.ae/ar/ [R=301,L]

ErrorDocument 404 /404.html

# ── Disable caching for HTML pages ──────────────────────────
<FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# ── Cache static assets for 30 days ─────────────────────────
<FilesMatch "\.(css|js|svg|jpg|jpeg|png|webp|woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
