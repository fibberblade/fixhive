# Force UTF-8 charset on all text responses
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .htm .js .css .xml .json .txt

RewriteEngine On

# All rules below resolve straight to the final canonical URL in ONE hop,
# regardless of which combination of protocol/host/path the request came in as.
# (Previously http+www requests took 2 hops: http->https first, then www->non-www
# as a second redirect, since the old rule 1 used [L] before www was ever checked.)

# 1. Any request for /index.html -> https://myfixhive.ae/
RewriteCond %{REQUEST_URI} ^/index\.html$
RewriteRule ^ https://myfixhive.ae/ [R=301,L]

# 2. Any request for /ar/index.html -> https://myfixhive.ae/ar/
RewriteCond %{REQUEST_URI} ^/ar/index\.html$
RewriteRule ^ https://myfixhive.ae/ar/ [R=301,L]

# 5. Short-URL aliases -> canonical SEO pages (301)
RewriteRule ^diagnostics\.html$ https://myfixhive.ae/car-diagnostics-dubai.html [R=301,L]
RewriteRule ^ac-service\.html$ https://myfixhive.ae/car-ac-repair-dubai.html [R=301,L]
RewriteRule ^pre-purchase-inspection\.html$ https://myfixhive.ae/pre-purchase-inspection-dubai.html [R=301,L]
RewriteRule ^engine\.html$ https://myfixhive.ae/engine-repair-dubai.html [R=301,L]
RewriteRule ^ar/engine\.html$ https://myfixhive.ae/ar/engine-repair-dubai.html [R=301,L]
RewriteRule ^ar/electrical\.html$ https://myfixhive.ae/ar/electrical-repair-dubai.html [R=301,L]

# 3. Any request to the www host (any protocol, any other page) -> https non-www
RewriteCond %{HTTP_HOST} ^www\.myfixhive\.ae$ [NC]
RewriteRule ^(.*)$ https://myfixhive.ae/$1 [R=301,L]

# 4. Remaining HTTP requests (already non-www at this point) -> HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://myfixhive.ae/$1 [R=301,L]

ErrorDocument 404 /404.html

# ── Disable caching for HTML pages ──────────────────────────
<FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# ── Cache static assets for 30 days ─────────────────────────
<FilesMatch "\.(css|js|svg|jpg|jpeg|png|webp|woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
